{
  "name": "Advent of Code 2025",
  "dockerComposeFile": "docker-compose.yml",
  "service": "devcontainer",
"workspaceFolder": "/workspaces/advent-of-code",

  "features": {
    "ghcr.io/devcontainers/features/go:1": {},
    "ghcr.io/devcontainers-extra/features/groovy-sdkman:2": {},
    "ghcr.io/devcontainers/features/terraform:1": {},
    "ghcr.io/devcontainers/features/dotnet:2": {},
    "ghcr.io/devcontainers-extra/features/kotlin-sdkman:2": {},
    "ghcr.io/devcontainers/features/powershell:1": {}
  },
  "postCreateCommand": "mkdir -p ~/.continue && ln -sf /workspaces/advent-of-code/.continue/config.yaml ~/.continue/config.yaml",
  "customizations": {
    "vscode": {
      "extensions": [
        "NicolasVuillamy.vscode-groovy-lint",
        "yzhang.markdown-all-in-one",
        "ms-dotnettools.csharp",
        "ms-dotnettools.csdevkit",
        "ms-vscode.powershell",
        "Continue.continue"
      ]
    }
  }
}
